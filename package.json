{
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite dev --open",
        "build": "vite build",
        "preview": "vite preview",
        "postinstall": "node scripts/link-uikit.js && cd ./static/assets/uikit && pnpm install",
        "compile": "pnpm compile-less && pnpm compile-uikit-tests",
        "compile-less": "make-dir static/css && lessc less/theme.less > static/css/theme.css --rewrite-urls=all --clean-css",
        "compile-uikit-tests": "cd ./static/assets/uikit && pnpm compile-js tests"
    },
    "packageManager": "pnpm@12.9.1",
    "devDependencies": {
        "@docsearch/css": "^3.9.0",
        "@docsearch/js": "^3.9.0",
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-static": "4.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.0",
        "execa": "^10.0.1",
        "github-slugger": "^2.0.0",
        "globals": "^17.13.0",
        "highlight.js": "11.12.0",
        "less": "^4.9.1",
        "less-plugin-clean-css": "^1.6.0",
        "make-dir-cli": "^4.0.0",
        "marked": "^18.0.14",
        "prettier": "^3.9.9",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.1",
        "uikit": "3.25.26",
        "vite": "^8.3.2"
    }
}
