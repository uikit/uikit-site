{
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite dev --open",
        "build": "vite build",
        "preview": "vite preview",
        "postinstall": "symlink-dir ./node_modules/uikit ./static/assets/uikit && cd ./static/assets/uikit && pnpm install",
        "compile": "pnpm compile-less && pnpm compile-uikit-tests",
        "compile-less": "make-dir static/css && lessc less/theme.less > static/css/theme.css --rewrite-urls=all --clean-css",
        "compile-uikit-tests": "cd ./static/assets/uikit && pnpm compile-js tests"
    },
    "packageManager": "pnpm@10.33.0",
    "devDependencies": {
        "@docsearch/css": "^3.9.0",
        "@docsearch/js": "^3.9.0",
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-static": "3.0.10",
        "@sveltejs/kit": "^2.70.0",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "clipboard": "2.0.11",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.20.0",
        "execa": "^10.0.0",
        "github-slugger": "^2.0.0",
        "globals": "^17.7.0",
        "highlight.js": "11.11.1",
        "less": "^4.7.0",
        "less-plugin-clean-css": "^1.6.0",
        "make-dir-cli": "^4.0.0",
        "marked": "^18.0.6",
        "prettier": "^3.9.5",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.56.6",
        "symlink-dir": "^7.1.0",
        "uikit": "3.25.20",
        "vite": "^8.1.5"
    },
    "pnpm": {
        "peerDependencyRules": {
            "ignoreMissing": [
                "@algolia/client-search"
            ]
        }
    }
}
